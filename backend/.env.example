# Copia a .env y exporta las variables antes de correr en local (o usa: node --env-file=.env src/server.js)
# En Cloud Run NO se usa este archivo: las variables y secretos se inyectan con gcloud run deploy.

PORT=8080

# --- Cloud SQL ---
# Local: corre el Cloud SQL Auth Proxy (127.0.0.1:5432) y usa DB_HOST.
# Cloud Run: se usa INSTANCE_CONNECTION_NAME (socket /cloudsql/...), DB_HOST no se define.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app
DB_NAME=guiame
DB_PASS=cambia-esto
# INSTANCE_CONNECTION_NAME=guiameapp:us-east1:guiame-sql

# --- Secret Manager (llega como variable de entorno en Cloud Run) ---
JWT_SECRET=una-cadena-aleatoria-larga-de-al-menos-32-caracteres

# --- Cloud Storage ---
MEDIA_BUCKET=guiameapp-media

# --- Vertex AI ---
GCP_PROJECT=guiameapp
VERTEX_LOCATION=us-east1
GEMINI_MODEL=gemini-2.5-flash

# --- Opcional ---
# CORS_ORIGINS=http://localhost:5173
